{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve ShoeBoxx",
            "type": "shell",
            "command": "py -m http.server 8080",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".*",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Serving HTTP on .* port 8080 .*"
                }
            }
        }
    ]
}
